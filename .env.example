# Gemini / OpenAI-compatible provider (backend only; never exposed to the browser)
LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# Firebase Web app config (public client config, from Project settings -> General -> Your apps)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=

# LOCAL DEVELOPMENT ONLY: use the Firebase Auth emulator instead of a real project.
# Leave unset in any real deployment. Tokens from the emulator are NOT cryptographically verified.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
